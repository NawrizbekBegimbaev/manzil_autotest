[
{"id":"INT-001","razdel":"Интеграции","screen":"1C webhook /integrations/1c/shipments/status","scenario":"Без заголовка X-Webhook-Token","precond":"ONEC_WEBHOOK_SECRET сконфигурирован; есть IN_TRANSIT заказ","steps":"1. POST /api/v1/integrations/1c/shipments/status с валидным body {eventId, licensePlate}\n2. Заголовок X-Webhook-Token не передаётся","expected":"401, code=error.unauthorized; заказ не меняет статус","priority":"High","comment":"api"},
{"id":"INT-002","razdel":"Интеграции","screen":"1C webhook /shipments/status","scenario":"Неверный токен","precond":"Секрет сконфигурирован","steps":"1. POST с X-Webhook-Token: WRONG-VALUE\n2. body валидный","expected":"401, code=error.unauthorized (constant-time сравнение MessageDigest.isEqual)","priority":"High","comment":"api"},
{"id":"INT-003","razdel":"Интеграции","screen":"1C webhook /shipments/status","scenario":"Пустой токен","precond":"Секрет сконфигурирован","steps":"1. POST с X-Webhook-Token: \"\" (пустая строка)","expected":"401, code=error.unauthorized (token.isBlank() → fail-closed)","priority":"Medium","comment":"api"},
{"id":"INT-004","razdel":"Интеграции","screen":"1C webhook /shipments/status","scenario":"Секрет не сконфигурирован на сервере (blank)","precond":"ONEC_WEBHOOK_SECRET пустой/не задан","steps":"1. POST с любым корректным X-Webhook-Token и body","expected":"401, code=error.unauthorized (webhookSecret.isBlank() → всегда отказ, fail-closed)","priority":"High","comment":"api"},
{"id":"INT-005","razdel":"Интеграции","screen":"1C webhook /shipments/status","scenario":"Happy-path: одиночное событие DELIVERED завершает заказ","precond":"Верный токен; ровно один IN_TRANSIT заказ с привязанным плейтом 01A123BC","steps":"1. POST с верным токеном, body {eventId:\"ev-1\", licensePlate:\"01A123BC\"}\n2. Проверить статус заказа","expected":"200; заказ IN_TRANSIT→COMPLETED; ProcessedWebhookEvent сохранён в той же транзакции","priority":"High","comment":"api"},
{"id":"INT-006","razdel":"Интеграции","screen":"1C webhook /shipments/status","scenario":"Идемпотентность по eventId (дубль)","precond":"Событие eventId=ev-1 уже обработано, заказ COMPLETED","steps":"1. Повторно POST с тем же eventId=ev-1 и тем же плейтом","expected":"200, no-op (existsByEventId→early return); заказ остаётся COMPLETED, повторного завершения нет","priority":"High","comment":"api"},
{"id":"INT-007","razdel":"Интеграции","screen":"1C webhook /shipments/status","scenario":"Нормализация плейта при матчинге","precond":"Заказ IN_TRANSIT с order_drivers.license_plate=01A123BC","steps":"1. POST с licensePlate:\"01 A 123-BC\" (пробелы, дефис)","expected":"200; нормализация [\\s.\\-/·]→upper матчит тот же заказ; IN_TRANSIT→COMPLETED","priority":"High","comment":"api"},
{"id":"INT-008","razdel":"Интеграции","screen":"1C webhook /shipments/status","scenario":"Плейт не найден среди активных рейсов","precond":"Нет IN_TRANSIT заказа с таким плейтом (или плейт вообще не привязан)","steps":"1. POST с верным токеном, licensePlate:\"99Z999ZZ\"","expected":"404, code=error.webhook.no-active-shipment","priority":"High","comment":"api"},
{"id":"INT-009","razdel":"Интеграции","screen":"1C webhook /shipments/status","scenario":"Плейт есть, но заказ уже не IN_TRANSIT","precond":"Привязка плейта существует, но заказ COMPLETED/CANCELLED (нет IN_TRANSIT)","steps":"1. POST с этим плейтом","expected":"404, code=error.webhook.no-active-shipment (filterIdsByStatus IN_TRANSIT пуст)","priority":"Medium","comment":"api"},
{"id":"INT-010","razdel":"Интеграции","screen":"1C webhook /shipments/status","scenario":"Неоднозначный плейт (>1 IN_TRANSIT)","precond":"Два разных IN_TRANSIT заказа имеют один и тот же нормализованный плейт","steps":"1. POST с этим плейтом","expected":"409, code=error.webhook.ambiguous-plate; ни один заказ не завершён","priority":"High","comment":"api"},
{"id":"INT-011","razdel":"Интеграции","screen":"1C webhook /shipments/status","scenario":"Отсутствует обязательный eventId","precond":"Верный токен","steps":"1. POST body без eventId (или blank)","expected":"400, code=error.bad-request; errors[].field=eventId (@NotBlank)","priority":"Medium","comment":"api"},
{"id":"INT-012","razdel":"Интеграции","screen":"1C webhook /shipments/status","scenario":"Отсутствует обязательный licensePlate","precond":"Верный токен","steps":"1. POST body {eventId:\"ev-x\"} без licensePlate","expected":"400, code=error.bad-request; errors[].field=licensePlate (@NotBlank)","priority":"Medium","comment":"api"},
{"id":"INT-013","razdel":"Интеграции","screen":"1C webhook /shipments/status","scenario":"event=null дефолтится в DELIVERED","precond":"Верный токен; один IN_TRANSIT заказ по плейту","steps":"1. POST без поля event (null)","expected":"200; обработано как DELIVERED; заказ IN_TRANSIT→COMPLETED","priority":"Low","comment":"api"},
{"id":"INT-014","razdel":"Интеграции","screen":"1C batch /shipments/status/batch","scenario":"Batch happy-path: несколько валидных событий","precond":"Верный токен; 3 разных IN_TRANSIT заказа по 3 плейтам","steps":"1. POST /batch с items=[3 события]","expected":"200; body total=3, succeeded=3, failed=0; каждый ItemResult ok; все 3 заказа COMPLETED","priority":"High","comment":"api"},
{"id":"INT-015","razdel":"Интеграции","screen":"1C batch /shipments/status/batch","scenario":"Изоляция элементов: один плейт неизвестен","precond":"Верный токен; item#1 валиден, item#2 неизвестный плейт, item#3 валиден","steps":"1. POST /batch с 3 элементами","expected":"HTTP 200; succeeded=2, failed=1; item#2 ItemResult failure status=404 key=error.webhook.no-active-shipment; item#1 и #3 COMPLETED (своя транзакция на элемент)","priority":"High","comment":"api"},
{"id":"INT-016","razdel":"Интеграции","screen":"1C batch /shipments/status/batch","scenario":"Пустой batch (items=[])","precond":"Верный токен","steps":"1. POST /batch с items:[]","expected":"400, code=error.bad-request (@NotEmpty)","priority":"Medium","comment":"api"},
{"id":"INT-017","razdel":"Интеграции","screen":"1C batch /shipments/status/batch","scenario":"Batch свыше лимита (501 элемент)","precond":"Верный токен","steps":"1. POST /batch с items длиной 501","expected":"400, code=error.bad-request; message validation.batch.too-large (@Size max=500)","priority":"Medium","comment":"api"},
{"id":"INT-018","razdel":"Интеграции","screen":"1C batch /shipments/status/batch","scenario":"Batch на границе 500 элементов","precond":"Верный токен; элементы валидны/допустимы","steps":"1. POST /batch ровно с 500 элементами","expected":"200; envelope обработан (per-item результаты); код не 400","priority":"Low","comment":"api"},
{"id":"INT-019","razdel":"Интеграции","screen":"1C batch /shipments/status/batch","scenario":"Batch без токена","precond":"Секрет сконфигурирован","steps":"1. POST /batch с валидным envelope без X-Webhook-Token","expected":"401, code=error.unauthorized (verifyToken до обработки)","priority":"High","comment":"api"},
{"id":"INT-020","razdel":"Уведомления","screen":"GET /me/notifications","scenario":"Список уведомлений пагинирован, новые первыми","precond":"У пользователя ≥1 уведомление (TRANSPORT_SELECTED/DRIVERS_ATTACHED)","steps":"1. GET /api/v1/me/notifications","expected":"200; PageResponse; сортировка createdAt DESC; size=20 по умолчанию; title/body локализованы под язык запроса; только свои уведомления","priority":"High","comment":"api"},
{"id":"INT-021","razdel":"Уведомления","screen":"GET /me/notifications/unread-count","scenario":"Счётчик непрочитанных (бейдж)","precond":"У пользователя 2 непрочитанных, 1 прочитанное","steps":"1. GET /me/notifications/unread-count","expected":"200; {count:2} (countByRecipientUserIdAndReadAtIsNull)","priority":"Medium","comment":"api"},
{"id":"INT-022","razdel":"Уведомления","screen":"POST /me/notifications/{id}/read","scenario":"Отметить прочитанным (идемпотентно)","precond":"Есть непрочитанное уведомление id=N","steps":"1. POST /me/notifications/{N}/read\n2. Повторить POST ещё раз","expected":"оба раза 204; readAt ставится только при первом (idempotent, readAt не перезаписывается); unread-count уменьшается на 1","priority":"High","comment":"api"},
{"id":"INT-023","razdel":"Уведомления","screen":"POST /me/notifications/read-all","scenario":"Отметить все прочитанными","precond":"У пользователя несколько непрочитанных","steps":"1. POST /me/notifications/read-all\n2. GET unread-count","expected":"204; unread-count=0 (markAllReadForRecipient)","priority":"Medium","comment":"api"},
{"id":"INT-024","razdel":"Уведомления","screen":"DELETE /me/notifications/{id}","scenario":"Удаление уведомления (soft-delete)","precond":"Есть уведомление id=N у пользователя","steps":"1. DELETE /me/notifications/{N}\n2. GET /me/notifications","expected":"204; уведомление исчезает из списка (soft-delete @SoftDelete)","priority":"Medium","comment":"api"},
{"id":"INT-025","razdel":"Уведомления","screen":"POST /me/notifications/{id}/read и DELETE","scenario":"Чужой/несуществующий id уведомления","precond":"id принадлежит другому пользователю или не существует","steps":"1. POST /me/notifications/{foreignId}/read\n2. DELETE /me/notifications/{foreignId}","expected":"оба 404, code=error.notification.not-found (findByIdAndRecipientUserId, BOLA-защита)","priority":"High","comment":"api"},
{"id":"INT-026","razdel":"Уведомления","screen":"POST /me/devices","scenario":"Регистрация устройства (upsert по emasDeviceId)","precond":"Авторизован любой ролью; emasDeviceId=dev-1 ещё не зарегистрирован","steps":"1. POST /me/devices {emasDeviceId:\"dev-1\", platform, app, language:\"ru\"}\n2. Повторить с тем же emasDeviceId под другим пользователем","expected":"200; первый создаёт запись; повтор не плодит дубль (findByEmasDeviceId), rebind на текущего userId; language возвращается","priority":"High","comment":"api"},
{"id":"INT-027","razdel":"Уведомления","screen":"POST /me/devices","scenario":"Неподдерживаемый language клампится в ru","precond":"Авторизован","steps":"1. POST /me/devices с language:\"en\" (≤8 символов)","expected":"200; в ответе language=ru (normalize: en не в {ru,uz,ky,zh,ug} → DEFAULT_LANGUAGE)","priority":"Medium","comment":"api"},
{"id":"INT-028","razdel":"Уведомления","screen":"POST /me/devices","scenario":"language длиннее 8 символов","precond":"Авторизован","steps":"1. POST /me/devices с language:\"russian-ru\" (>8)","expected":"400, code=error.bad-request; errors[].field=language; message validation.size.too-long (@Size max=8)","priority":"Medium","comment":"api"},
{"id":"INT-029","razdel":"Уведомления","screen":"POST /me/devices","scenario":"Поддерживаемый язык сохраняется как есть","precond":"Авторизован","steps":"1. POST /me/devices с language:\"ZH\" (верхний регистр)","expected":"200; language=zh (normalize trim+toLowerCase, входит в whitelist)","priority":"Low","comment":"api"},
{"id":"INT-030","razdel":"Уведомления","screen":"PATCH /me/devices/{id}","scenario":"Смена языка устройства; чужой id","precond":"id устройства принадлежит другому пользователю","steps":"1. PATCH /me/devices/{foreignId} {language:\"uz\"}","expected":"404, code=error.device.not-found (findByIdAndUserId, BOLA-защита)","priority":"High","comment":"api"},
{"id":"INT-031","razdel":"Файлы","screen":"POST /api/v1/files","scenario":"Happy-path: загрузка валидного JPEG ≤5 MiB","precond":"Авторизован Bearer; файл 1 MiB с magic bytes JPEG","steps":"1. POST multipart/form-data part file=photo.jpg","expected":"201; body {id (UUID), previewUrl (presigned, 24h), expiresAt}","priority":"High","comment":"api"},
{"id":"INT-032","razdel":"Файлы","screen":"POST /api/v1/files","scenario":"Файл в диапазоне 5–6 MiB","precond":"Авторизован; файл 5.5 MiB валидного типа","steps":"1. POST multipart part file (5.5 MiB)","expected":"400, code=error.file.too-large (size > maxFileBytes, multipart cap 6 MiB ещё не сработал)","priority":"High","comment":"api"},
{"id":"INT-033","razdel":"Файлы","screen":"POST /api/v1/files","scenario":"Файл >6 MiB (multipart resolver рубит)","precond":"Авторизован; файл 7 MiB","steps":"1. POST multipart part file (7 MiB)","expected":"413, code=error.request.too-large (MaxUploadSizeExceeded до сервиса)","priority":"High","comment":"api"},
{"id":"INT-034","razdel":"Файлы","screen":"POST /api/v1/files","scenario":"Неверный MIME по magic bytes (PDF/exe)","precond":"Авторизован; файл это PDF, даже с Content-Type image/png","steps":"1. POST multipart part file=doc.pdf (или переименованный)","expected":"400, code=error.file.invalid-type (Tika sniff не в {image/jpeg,image/png,image/webp}, заголовок Content-Type игнорируется)","priority":"High","comment":"api"},
{"id":"INT-035","razdel":"Файлы","screen":"POST /api/v1/files","scenario":"PNG и WebP принимаются","precond":"Авторизован; валидные PNG и WebP ≤5 MiB","steps":"1. POST part file=img.png\n2. POST part file=img.webp","expected":"оба 201 (image/png и image/webp в whitelist)","priority":"Medium","comment":"api"},
{"id":"INT-036","razdel":"Файлы","screen":"POST /api/v1/files","scenario":"Пустой/отсутствующий файл","precond":"Авторизован","steps":"1. POST multipart с пустым part file (0 байт)","expected":"400, code=error.file.missing (file.isEmpty())","priority":"Medium","comment":"api"},
{"id":"INT-037","razdel":"Файлы","screen":"POST /api/v1/files","scenario":"Без Bearer-токена","precond":"Не авторизован","steps":"1. POST /api/v1/files без Authorization","expected":"401 (path под anyRequest().authenticated())","priority":"Medium","comment":"api"},
{"id":"INT-038","razdel":"E2E Тендер","screen":"Сквозной тендер (мобайл склад → веб → мобайл перевозчик → 1C)","scenario":"Полный happy-path тендера до завершения через 1C","precond":"SHIPPER_WAREHOUSE (склад-моб), TRANSPORT_ADMIN (перевозчик-моб), SHIPPER_ADMIN (веб), driversCount=1, 1C секрет задан","steps":"1. WAREHOUSE: POST /warehouse/orders (loadDate=сегодня) → PUBLISHED\n2. TRANSPORT_ADMIN: POST /transport/orders/{id}/offers → PUBLISHED→QUOTED\n3. SHIPPER_ADMIN: POST /shipper/orders/{id}/offers/{offerId}/select → SELECTED\n4. TRANSPORT_ADMIN: POST /transport/orders/{id}/drivers {1 водитель+licensePlate}\n5. POST /transport/orders/{id}/start → IN_WORK (commStatus=PENDING)\n6. WAREHOUSE: POST /warehouse/orders/{id}/communication {CONFIRMED}\n7. WAREHOUSE: POST /warehouse/orders/{id}/goods-sent → IN_TRANSIT\n8. 1C: POST /integrations/1c/shipments/status {eventId, licensePlate}","expected":"Каждый шаг 2xx; финал заказа COMPLETED; offer победителя SELECTED, прочие REJECTED; 1C webhook вернул 200; уведомления TRANSPORT_SELECTED и DRIVERS_ATTACHED доставлены","priority":"High","comment":"e2e"},
{"id":"INT-039","razdel":"E2E Тендер","screen":"Веб /shipper/orders/{id} — выбор победителя","scenario":"Победителя выбирает только SHIPPER_ADMIN, не MANAGER","precond":"Заказ QUOTED с офферами; SHIPPER_MANAGER","steps":"1. SHIPPER_MANAGER: POST /shipper/orders/{id}/offers/{offerId}/select","expected":"403, code=error.forbidden (winner-select только SHIPPER_ADMIN)","priority":"High","comment":"e2e"},
{"id":"INT-040","razdel":"E2E Тендер","screen":"Мобайл перевозчик — старт рейса","scenario":"Старт без полного числа водителей","precond":"Заказ SELECTED, driversCount=2, привязан только 1 водитель","steps":"1. TRANSPORT_ADMIN: POST /transport/orders/{id}/start","expected":"409, code=error.order.drivers-incomplete (attached < driversCount); заказ остаётся SELECTED","priority":"High","comment":"e2e"},
{"id":"INT-041","razdel":"E2E Тендер","screen":"Мобайл склад — отправка груза","scenario":"goods-sent при commStatus≠CONFIRMED","precond":"Заказ IN_WORK, communicationStatus=PENDING","steps":"1. WAREHOUSE: POST /warehouse/orders/{id}/goods-sent","expected":"409 (требуется commStatus=CONFIRMED); заказ остаётся IN_WORK, не переходит в IN_TRANSIT","priority":"High","comment":"e2e"},
{"id":"INT-042","razdel":"E2E Тендер","screen":"Мобайл перевозчик — подача оффера","scenario":"Чужая роль/повторный выбор: select на не-QUOTED заказе","precond":"Заказ уже SELECTED (победитель выбран)","steps":"1. SHIPPER_ADMIN: повторный POST /shipper/orders/{id}/offers/{offerId}/select","expected":"409 (order must be QUOTED, нельзя выбрать дважды)","priority":"Medium","comment":"e2e"},
{"id":"INT-043","razdel":"E2E Тендер","screen":"Мобайл перевозчик — feed/оффер","scenario":"Дубль оффера от одной транспортной компании","precond":"Перевозчик уже подал оффер на заказ (PUBLISHED/QUOTED)","steps":"1. TRANSPORT_ADMIN: повторный POST /transport/orders/{id}/offers","expected":"409, code=error.offer.already-submitted (один активный оффер на (заказ, ТК))","priority":"Medium","comment":"e2e"},
{"id":"INT-044","razdel":"E2E Тендер","screen":"Мобайл склад — коммуникация","scenario":"communication вне статуса IN_WORK","precond":"Заказ SELECTED (ещё не стартован)","steps":"1. WAREHOUSE: POST /warehouse/orders/{id}/communication {CONFIRMED}","expected":"409 (communication только при IN_WORK)","priority":"Medium","comment":"e2e"},
{"id":"INT-045","razdel":"E2E Тендер","screen":"1C webhook — завершение чужого заказа","scenario":"1C завершает заказ другой компании по плейту (кросс-тенант)","precond":"Один IN_TRANSIT заказ другой shipper-компании с данным плейтом; верный 1C токен","steps":"1. 1C: POST /shipments/status с этим плейтом","expected":"200; заказ COMPLETED (webhook системный, не RBAC-ограничен по тенанту — матчинг по плейту IN_TRANSIT; проверить отсутствие утечки в кросс-тенантных оффер/order API)","priority":"Medium","comment":"e2e"},
{"id":"INT-046","razdel":"E2E Тендер","screen":"Мобайл перевозчик — привязка водителя","scenario":"Привязка водителя, занятого на другом активном заказе","precond":"Водитель уже на заказе в статусе IN_WORK; новый заказ SELECTED","steps":"1. TRANSPORT_ADMIN: POST /transport/orders/{id}/drivers {этот driverId}","expected":"409, code=error.driver.busy-on-another-order","priority":"Medium","comment":"e2e"},
{"id":"INT-047","razdel":"E2E Тендер","screen":"1C webhook — повтор после E2E завершения","scenario":"Идемпотентный повтор 1C после успешного E2E","precond":"E2E завершён через 1C (eventId=ev-final), заказ COMPLETED","steps":"1. 1C: повторный POST /shipments/status с eventId=ev-final","expected":"200 no-op; заказ остаётся COMPLETED, повторного completeBySystem нет","priority":"Low","comment":"e2e"}
]
