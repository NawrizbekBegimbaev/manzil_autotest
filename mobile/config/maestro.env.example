# Maestro (Android) sanity config. Copy to maestro.env and fill in.
# Loaded by scripts/run_mobile_sanity.sh and passed to `maestro test -e ...`.
# Nothing is hardcoded in the flows — appId and credentials come from here.

# Android application id of the STAGING warehouse build (confirmed on device).
APP_ID=uz.logos.manzil.warehouse.staging

# Warehouse operator login. The app's phone field is NATIONAL only (the +998 is
# fixed in the UI), so put the 9 national digits here, NOT the +998 prefix.
# Password must match the staging account. Provision a warehouse account via the
# web (SHIPPER ADMIN → Сотрудники → role "Сотрудник склада").
WAREHOUSE_PHONE=<9-national-digits>
WAREHOUSE_PASSWORD=<your-strong-password>
