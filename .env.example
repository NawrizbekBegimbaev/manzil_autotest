# Manzil UI sanity — environment. Copy to .env and fill in. Nothing is hardcoded
# in code; everything the suite needs lives here.

# ─── Target (STAGING) ────────────────────────────────────────────────────────
BASE_URL=https://staging-manzil.greatmall.uz

# ─── Credentials (phone in E.164, e.g. +998901234567; password; no OTP) ──────
# Only SUPER_ADMIN is required. ADMIN / MANAGER / CARRIER are provisioned by the
# suite itself (see conftest `provisioned`) and use NEW_ACCOUNT_PASSWORD.
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=
# Password assigned to the accounts the suite creates (must satisfy the policy:
# min 8 chars, upper, lower, digit, special).
NEW_ACCOUNT_PASSWORD=<your-strong-password>

# ─── Browser context (optional overrides) ────────────────────────────────────
LOCALE=ru-RU
TIMEZONE=Asia/Tashkent
DEFAULT_TIMEOUT_MS=15000
NAV_TIMEOUT_MS=30000

# ─── Telegram report delivery (leave empty to skip sending) ──────────────────
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_REPORT_ENV=STAGING
