# Manzil API tests — environment. Copy to .env and fill.

# ----- Target environment -----
# Pick one: dev | staging | prod.
# When set, API_BASE_URL and WEB_BASE_URL auto-resolve (override below if needed).
#   dev     → https://dev-manzil.greatmall.uz
#   staging → https://staging-manzil.greatmall.uz
#   prod    → https://manzil.greatmall.uz   (DESTRUCTIVE TESTS ARE BLOCKED)
MANZIL_ENV=dev

# ----- API base URL (open question #1) -----
# Override only if you need to point at a non-standard host. By default
# this resolves from MANZIL_ENV above.
API_BASE_URL=https://dev-manzil.greatmall.uz

# ----- Email OTP for web registration & web password reset -----
# fixed       → use EMAIL_OTP fixed code (dev backend stopped accepting fixed code on 2026-05-04)
# mailhog     → fetch latest email from mailhog by recipient
# endpoint    → fetch from EMAIL_OTP_ENDPOINT (e.g. POST /test/otp/{email})
# imap_gmail  → IMAP-fetch from real Gmail inbox
EMAIL_OTP_MODE=imap_gmail
EMAIL_OTP=123456
EMAIL_OTP_ENDPOINT=

# Gmail IMAP creds (only when EMAIL_OTP_MODE=imap_gmail).
# Use a Google App Password — generate at
# https://myaccount.google.com/apppasswords (requires 2FA on the account).
# NOT your regular Gmail password.
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=

# Set to 1 to actually run OTP-dependent tests (~180). Without it they
# auto-skip with a clear reason.
MANZIL_OTP_CAPTURE=0

# ----- Telegram OTP for driver mobile registration (open question #3) -----
# fixed     → use TELEGRAM_OTP fixed code
# endpoint  → fetch from TELEGRAM_OTP_ENDPOINT (e.g. POST /test/otp/{phone})
TELEGRAM_OTP_MODE=fixed
TELEGRAM_OTP=123456
TELEGRAM_OTP_ENDPOINT=

# ----- Test data pools -----
PHONE_POOL_START=998900000001
PHONE_POOL_END=998900000050
# When EMAIL_OTP_MODE=imap_gmail, pool generates plus-aliases of
# GMAIL_IMAP_USER (e.g. you+e2e-001@gmail.com); this domain is then
# ignored. Kept for backwards-compat with `fixed` mode.
EMAIL_POOL_DOMAIN=gmail.com
EMAIL_POOL_SIZE=50

# ----- TIN (UZ Tax Identification Number) — 12 digits per Swagger examples -----
# If backend validates a checksum, set TIN_CHECKSUM=true and implement in utils/tin_generator.py
TIN_CHECKSUM=false

# ----- Password policy (open question #5) -----
# Default matches Swagger example "P@ssw0rd!" — uppercase + lowercase + digit + symbol, len>=8
DEFAULT_TEST_PASSWORD=P@ssw0rd!

# ----- HTTP client -----
HTTP_TIMEOUT_S=15
HTTP_VERIFY_SSL=true

# ----- Web-UI tests (Playwright) -----
# Same domain as the API on dev (frontend + backend served same-origin).
WEB_BASE_URL=https://dev-manzil.greatmall.uz

# Pre-verified shared accounts for post-OTP UI flows. Real Keycloak users —
# do NOT delete or change roles. Tests must clean up created data
# (orders, warehouses, vehicles, offers) but never the accounts themselves.
SUPPLIER_ADMIN_REAL_EMAIL=nbegimbaev2006@gmail.com
SUPPLIER_DISPATCHER_REAL_EMAIL=nbegimbaev2020@gmail.com
SUPPLIER_MANAGER_REAL_EMAIL=nbegimbaev56@gmail.com
TK_REAL_EMAIL=202390415@ajou.uz
REAL_ACCOUNT_PASSWORD=Nawrizbek_20

# Set UI_HEADED=1 to watch the browser locally; CI always runs headless.
UI_HEADED=false
UI_SLOW_MO_MS=0
UI_DEFAULT_TIMEOUT_MS=10000
UI_TRACE_ON_FAILURE=true

# ----- Mobile (Maestro) -----

# Android: either an APK path for fresh install, or app_id of an already installed app.
ANDROID_APP_PATH=
ANDROID_APP_ID=
ANDROID_DEVICE_ID=

# iOS: either a .app path for simulator / .ipa for real device, or bundleId.
IOS_APP_PATH=
IOS_APP_ID=
IOS_DEVICE_NAME=iPhone 15
IOS_PLATFORM_VERSION=17.0

# Maestro
MAESTRO_DEFAULT_TIMEOUT_MS=10000
MAESTRO_FLOWS_DIR=mobile/flows
